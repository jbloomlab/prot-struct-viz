<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title }}</title>
<script src="https://cdn.jsdelivr.net/npm/molstar@{{ molstar_version }}/build/viewer/molstar.js"></script>
<link rel="stylesheet" type="text/css"
      href="https://cdn.jsdelivr.net/npm/molstar@{{ molstar_version }}/build/viewer/molstar.css">
<style>
  /* Reserve the scrollbar gutter whether or not a scrollbar is showing. Without
     this, anything that changes the page height -- switching to a shorter caption,
     resizing the window -- can make the scrollbar appear or vanish, which changes
     the content width, which resizes the Mol* canvas. The structure then appears
     to jump sideways for reasons that have nothing to do with the structure. */
  html { scrollbar-gutter: stable; }
  body { margin: 0; padding: 0.75rem 1rem 1rem;
         font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
         color: #24292f; }
  /* Every caption occupies the same grid cell, so the block is always as tall as
     the longest one and switching views cannot change the page height. Hidden
     captions keep their space -- hence visibility rather than display. */
  #header { display: grid; max-width: 60rem; margin-top: 1rem; }
  #header:empty { display: none; }
  #header > .caption { grid-area: 1 / 1; visibility: hidden; }
  #header > .caption.active { visibility: visible; }
  #controls { display: flex; gap: 0.5rem; align-items: center; margin: 0.75rem 0; }
  #controls button { font: inherit; padding: 0.3rem 0.7rem; cursor: pointer;
                     border: 1px solid #d0d7de; border-radius: 6px; background: #f6f8fa; }
  #controls button:hover { background: #eaeef2; }
  /* Sized for the longest view name, so choosing a different view does not widen
     the select and shuffle everything to its right. */
  #controls select { font: inherit; padding: 0.3rem 0.4rem; cursor: pointer;
                     border: 1px solid #d0d7de; border-radius: 6px; background: #f6f8fa;
                     min-width: {{ select_width + 4 }}ch; }
  #controls label { display: flex; gap: 0.3rem; align-items: center; cursor: pointer;
                    user-select: none; }
  #status { color: #57606a; font-size: 0.9rem; }
  #camera-out { display: none; max-width: 60rem; margin: 0 0 0.75rem;
                padding: 0.6rem 0.8rem; background: #f6f8fa; border: 1px solid #d0d7de;
                border-radius: 6px; font-size: 0.85rem; overflow-x: auto;
                white-space: pre; user-select: all; }
  /* Mol* fills this box and positions its own UI inside it. */
  #viewer { position: relative; width: 100%; height: {{ viewer_height }}; }
  /* Mol*'s snapshot stepper. This package expresses views as one state with hidden
     subtrees, never as MVS snapshots, so there is only ever the single snapshot the
     loader registers -- and with no title it reads as "[1/1] <timestamp>" beside a
     play button that cycles a list of one. No Mol* config option suppresses it. */
  .msp-state-snapshot-viewport-controls { display: none; }
</style>
</head>
<body>

<div id="viewer"></div>

{# Controls and caption both sit below the structure, so the page opens on the view
   rather than on however many paragraphs the Markdown runs to. The controls come
   first of the two, staying next to the thing they act on. #}
<div id="controls">
{%- if views | length > 1 %}
  <label title="Switch between the views this page was built with. Every view is
already drawn, so switching only changes what is shown.">
    View
    <select id="view-select">
    {%- for view in views %}
      <option value="{{ view.slug }}">{{ view.name }}</option>
    {%- endfor %}
    </select></label>
{%- endif %}
  <button id="reset-view" type="button"
          title="Reload this page as it was generated. A representation added from the
Mol* panel is not colored by the CSV; this puts the coloring back.">Reset view</button>
{%- if show_label_toggle %}
  <label title="Show or hide every label drawn on the structure, including the copy on
each symmetry mate. Mouseover tooltips are separate and keep working either way.">
    <input id="label-toggle" type="checkbox" checked> Labels</label>
{%- endif %}
  {# Authoring tool, not a reader's control: hidden unless the URL ends in #camera. #}
  <button id="copy-camera" type="button" hidden
          title="Copy the current camera as a spec-file orientation block, for the
view now on screen.">Copy camera</button>
  <span id="status">Loading structure&hellip;</span>
</div>

<pre id="camera-out"></pre>

{# One caption per view; the selector shows the one belonging to the view on screen. #}
<div id="header">
{%- if has_captions %}
{%- for view in views %}
  <div class="caption{% if loop.first %} active{% endif %}" data-view="{{ view.slug }}">{{ view.caption | safe }}</div>
{%- endfor %}
{%- endif %}
</div>

{# The whole page -- coordinates, annotations, and the MVS state -- as a base64
   MVSX archive. Kept in a non-executing script block so the payload is never
   parsed as JavaScript. #}
<script id="mvsx-payload" type="text/plain">{{ mvsx_base64 }}</script>

<script>
(function () {
    var status = document.getElementById('status');
    var payload = document.getElementById('mvsx-payload').textContent.trim();
    var VIEWS = {{ views | map(attribute='slug') | list | tojson }};
    var NAMES = {{ views | map(attribute='name') | list | tojson }};
    // MVS refs, built by viewer.view_ref so the format lives in one place.
    var REFS = {{ views | map(attribute='ref') | list | tojson }};
    // Per view: a camera snapshot to move to, or null to leave the camera alone.
    var ORIENTATIONS = {{ views | map(attribute='orientation') | list | tojson }};
    var CAMERA_MS = 400;

    // The page's whole URL contract: '#' then '&'-separated tokens. Two are
    // recognised, `view=<slug>` and `camera`; anything else is ignored, so a
    // fragment a reader mangled degrades to the default view rather than to
    // nothing. A fragment rather than a query string because it is never sent
    // anywhere and behaves the same over file://, a local server, and Pages.
    function fragment() {
        var parsed = {view: null, camera: false};
        window.location.hash.replace(/^#/, '').split('&').forEach(function (token) {
            if (token === 'camera') {
                parsed.camera = true;
            } else if (token.indexOf('view=') === 0) {
                // A view name is only mostly ASCII by convention, so the slug can
                // arrive percent-encoded -- and decoding a malformed one throws.
                try {
                    parsed.view = decodeURIComponent(token.slice(5));
                } catch (err) {
                    console.warn('prot-struct-viz: unreadable view in ' + window.location.hash);
                }
            }
        });
        return parsed;
    }

    function fail(err) {
        status.textContent = 'Failed to load: ' + err;
        console.error(err);
    }

    molstar.Viewer.create('viewer', {
        layoutIsExpanded: false,
        // Mol*'s own panels. false starts them closed rather than removing them:
        // the wrench in the viewport is gated by a separate config and stays, so a
        // reader can always open them.
        layoutShowControls: {{ 'true' if molstar_ui_shown else 'false' }},
        layoutShowSequence: true,
        layoutShowLog: false,
        layoutShowRemoteState: false,
        layoutShowLeftPanel: true,
        collapseLeftPanel: true,
        // The camera icon, which is the only route to an image. Its own panel is
        // where the resolution is set, so a button of ours beside Reset view could
        // only ever download at whatever that panel already said.
        viewportShowScreenshotControls: true,
        viewportShowExpand: true,
        viewportShowSelectionMode: true,
        viewportShowAnimation: false
    }).then(function (viewer) {
        // Deliberately global: docs/spec.md tells an author to reach the raw camera
        // through `viewer.plugin.canvas3d.camera.getSnapshot()` in the console.
        window.viewer = viewer;
{%- if illustrative %}

        // Mol*'s own Quick Styles > Illustrative, which is exactly this: ignoreLight on
        // every representation, plus outline and ambient occlusion in postprocessing.
        // It deliberately says nothing about color -- Mol*'s illustrative *color theme*
        // is a separate button that recolors by chain, and would throw away the
        // per-residue coloring this page exists to show. The values are Mol*'s own.
        //
        // It runs after every load rather than once, because loadMvsData mints new
        // representation cells and ignoreLight is a parameter on each one: Reset view
        // would otherwise come back lit.
        function applyStyle() {
            var components = viewer.plugin.managers.structure.component;
            return components.setOptions(
                Object.assign({}, components.state.options, {ignoreLight: true})
            ).then(function () {
                viewer.plugin.canvas3d.setProps({
                    postprocessing: {
                        outline: {name: 'on', params: {
                            scale: 1, color: 0x000000, threshold: 0.33,
                            includeTransparent: true}},
                        occlusion: {name: 'on', params: {
                            multiScale: {name: 'off', params: {}}, radius: 5, bias: 0.8,
                            blurKernelSize: 15, blurDepthBias: 0.5, samples: 32,
                            resolutionScale: 1, color: 0x000000,
                            transparentThreshold: 0.4}},
                        shadow: {name: 'off', params: {}}
                    }
                });
            });
        }
{%- endif %}

        // MVS attaches per-residue color to each representation it creates, so a
        // representation added later from the Components panel comes in uncolored
        // and cannot be colored from the UI. Reloading the state is the way back.
        // The payload is still sitting in the DOM, so keeping this costs nothing.
        function load() {
            return viewer.loadMvsData('base64,' + payload, 'mvsx')
{{- '.then(applyStyle)' if illustrative else '' }};
        }

        var PSO = molstar.lib.plugin.PluginStateObject;
        var toggle = document.getElementById('label-toggle');
        var select = document.getElementById('view-select');

        function activeIndex() {
            return select ? VIEWS.indexOf(select.value) : 0;
        }

        // Point the selector at whatever the URL names, and say whether it did.
        // A slug this page does not have is not an error: the page opens on its
        // first view, which is what a reader following a stale link should get.
        function selectFromFragment() {
            var wanted = fragment().view;
            if (!select || !wanted || VIEWS.indexOf(wanted) === -1) return false;
            select.value = wanted;
            return true;
        }

        // Keep the address bar naming what is on screen, so sharing a view is
        // copying the URL. replaceState rather than assigning location.hash: Back
        // still leaves the page instead of walking the views, and it fires no
        // hashchange, so the listener below needs no guard against our own writes.
        function writeFragment() {
            var tokens = ['view=' + encodeURIComponent(select.value)];
            if (fragment().camera) tokens.push('camera');   // never strip an author's button
            var hash = '#' + tokens.join('&');
            if (window.location.hash === hash) return;
            try {
                history.replaceState(null, '', location.pathname + location.search + hash);
            } catch (err) {
                // Some browsers refuse replaceState over file://, where a link is
                // not shareable anyway. Reading the fragment still works there.
            }
        }

        // Which view each state cell belongs to, as {cell ref: view slug}.
        //
        // Every view is one MVS structure node carrying ref="view:<slug>", which
        // Mol* records as the cell tag "mvs-ref:view:<slug>" and resolves through
        // queryMVSRef. Everything the view draws hangs below that node, so the
        // owner map is that node plus its descendants. Rebuilt after every load,
        // because reloading the payload mints fresh cell refs.
        function ownerBySlug() {
            var state = viewer.plugin.state.data;
            var util = molstar.PluginExtensions.mvs.util;
            var owner = {};
            VIEWS.forEach(function (slug, index) {
                var found = util.queryMVSRef(viewer.plugin, REFS[index]);
                if (!found || !found.length) {
                    console.warn('prot-struct-viz: no cell tagged for view ' + slug);
                    return;
                }
                var stack = [found[0].transform.ref];
                while (stack.length) {
                    var ref = stack.pop();
                    owner[ref] = slug;
                    var children = state.tree.children.get(ref);
                    if (children) children.forEach(function (child) { stack.push(child); });
                }
            });
            return owner;
        }

        // One rule covers both controls, so neither can undo the other: a cell is
        // hidden if it belongs to a view that is not on screen, or it draws labels
        // and the Labels box is unchecked.
        //
        // Labels are found by object type rather than by transform name. Transform
        // ids are namespace-qualified -- the primitive builder is
        // "mvs.mvs-build-primitive-shape", not the bare name in the source -- and
        // "shape-representation-3d" is registered under two namespaces, so name
        // matching is both easy to get wrong and ambiguous. Scoping the scan to one
        // view's subtree also keeps it off any shape a reader adds from the Mol* UI.
        function applyVisibility() {
            var state = viewer.plugin.state.data;
            var active = select ? select.value : VIEWS[0];
            var labelsShown = !toggle || toggle.checked;
            var owner = ownerBySlug();
            Object.keys(owner).forEach(function (ref) {
                var cell = state.cells.get(ref);
                if (!cell) return;
                var isLabel = cell.obj && PSO.Shape.Representation3D.is(cell.obj);
                state.updateCellState(ref, {
                    isHidden: owner[ref] !== active || (isLabel && !labelsShown)
                });
            });
            Array.prototype.forEach.call(
                document.querySelectorAll('.caption'),
                function (caption) {
                    caption.classList.toggle(
                        'active', caption.getAttribute('data-view') === active);
                }
            );
        }

        // setSnapshot rather than canvas3d.camera.setState: it merges the stored
        // camera over a scene-fit baseline and recomputes radiusMax from the scene,
        // so a radius captured on one structure cannot clip on another. The second
        // argument is a transition duration, which is what animates the move.
        function applyOrientation(ms) {
            var orientation = ORIENTATIONS[activeIndex()];
            if (!orientation) return;   // this view has no opinion; leave the camera
            viewer.plugin.managers.camera.setSnapshot(
                orientation, ms === undefined ? CAMERA_MS : ms);
        }

        // Placing the camera from scratch -- on load, and after Reset reloads the
        // state. Two differences from applyOrientation. A view pinning no camera of
        // its own falls back to the opening view's, because that is what a reader
        // gets by loading the page and switching to it, and a link to such a view
        // should land in the same place. And it never animates: there is no pose the
        // reader has seen for us to glide away from.
        //
        // It has to run even on a plain load. The state's own camera node is only an
        // approximation -- MolViewSpec reads its position as a reference camera and
        // scales the distance to the target by 1/(2*sin(fov/2)), about 1.31 at the
        // default field of view -- so left alone the page opens a third too far out,
        // and every capture of a camera back into the spec drifts further.
        function placeOpeningCamera() {
            var orientation = ORIENTATIONS[activeIndex()] || ORIENTATIONS[0];
            if (!orientation) return;   // nothing pinned anywhere; Mol*'s fit stands
            viewer.plugin.managers.camera.setSnapshot(orientation, 0);
        }

        if (toggle) { toggle.addEventListener('change', applyVisibility); }
        // Switching views writes isHidden and nothing else, so unless the view being
        // shown carries an orientation the camera stays exactly where the reader
        // left it. That is the whole reason the views are prebuilt rather than
        // reloaded one at a time.
        if (select) {
            select.addEventListener('change', function () {
                applyVisibility();
                applyOrientation();
                writeFragment();
            });
        }

        // Someone pasted a different fragment into the address bar of a page that
        // is already open. This is the one path where the glide is right: the
        // reader is looking at the pose we are leaving.
        window.addEventListener('hashchange', function () {
            if (selectFromFragment()) {
                applyVisibility();
                applyOrientation();
            }
        });

        // --- authoring: capture the camera for a spec file ----------------------
        //
        // Shown only when the URL carries the `camera` token, so a published page
        // never has it. `#view=<slug>&camera` poses a view that is not the first.
        function cameraBlock() {
            var camera = viewer.plugin.canvas3d.camera.getSnapshot();
            var round = function (value) { return Math.round(value * 100) / 100; };
            var vec = function (v) { return '[' + [round(v[0]), round(v[1]), round(v[2])].join(', ') + ']'; };
            return [
                '# orientation for view: ' + NAMES[activeIndex()],
                '    orientation:',
                '      position: ' + vec(camera.position),
                '      target: ' + vec(camera.target),
                '      up: ' + vec(camera.up),
                '      radius: ' + round(camera.radius)
            ].join('\n');
        }
        window.psvCamera = function () {
            var text = cameraBlock();
            console.log(text);
            return text;
        };

        var copyButton = document.getElementById('copy-camera');
        var cameraOut = document.getElementById('camera-out');
        if (fragment().camera) {
            copyButton.hidden = false;
        }
        copyButton.addEventListener('click', function () {
            var text = cameraBlock();
            // Always show it. A rendered page is usually opened over file://, which
            // is not a secure context, so navigator.clipboard may not exist at all --
            // the visible box is what makes select-and-copy work regardless.
            cameraOut.textContent = text;
            cameraOut.style.display = 'block';
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(function () {
                    status.textContent = 'Camera copied to the clipboard.';
                }, function () {
                    status.textContent = 'Camera shown below; copy it from there.';
                });
            } else {
                status.textContent = 'Camera shown below; copy it from there.';
            }
        });

        document.getElementById('reset-view').addEventListener('click', function () {
            status.textContent = 'Resetting…';
            load().then(function () {
                applyVisibility();
                // Reloading restores the state's camera node, which frames the
                // first view and approximately at that. Reset undoes what a reader
                // did to the structure, not which view they chose, so put back the
                // pose that view opens with.
                placeOpeningCamera();
                status.textContent = '';
            }).catch(fail);
        });
        return load().then(function () {
            selectFromFragment();
            applyVisibility();
            placeOpeningCamera();
        });
    }).then(function () {
        status.textContent = '';
    }).catch(fail);
})();
</script>

</body>
</html>
