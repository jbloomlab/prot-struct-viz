<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title }}</title>
<script src="https://cdn.jsdelivr.net/npm/molstar@{{ molstar_version }}/build/viewer/molstar.js"></script>
<link rel="stylesheet" type="text/css"
      href="https://cdn.jsdelivr.net/npm/molstar@{{ molstar_version }}/build/viewer/molstar.css">
<style>
  body { margin: 0; padding: 0.75rem 1rem 1rem;
         font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
         color: #24292f; }
  #header { max-width: 60rem; margin-top: 1rem; }
  #header:empty { display: none; }
  .caption[hidden] { display: none; }
  #controls { display: flex; gap: 0.5rem; align-items: center; margin: 0.75rem 0; }
  #controls button { font: inherit; padding: 0.3rem 0.7rem; cursor: pointer;
                     border: 1px solid #d0d7de; border-radius: 6px; background: #f6f8fa; }
  #controls button:hover { background: #eaeef2; }
  #controls select { font: inherit; padding: 0.3rem 0.4rem; cursor: pointer;
                     border: 1px solid #d0d7de; border-radius: 6px; background: #f6f8fa; }
  #controls label { display: flex; gap: 0.3rem; align-items: center; cursor: pointer;
                    user-select: none; }
  #status { color: #57606a; font-size: 0.9rem; }
  /* Mol* fills this box and positions its own UI inside it. */
  #viewer { position: relative; width: 100%; height: 70vh; min-height: 30rem; }
</style>
</head>
<body>

<div id="viewer"></div>

{# Controls and caption both sit below the structure, so the page opens on the view
   rather than on however many paragraphs the Markdown runs to. The controls come
   first of the two, staying next to the thing they act on. #}
<div id="controls">
{%- if views | length > 1 %}
  <label title="Switch between the views this page was built with. Every view is
already drawn, so switching only changes what is shown -- the camera does not move.">
    View
    <select id="view-select">
    {%- for view in views %}
      <option value="{{ view.slug }}">{{ view.name }}</option>
    {%- endfor %}
    </select></label>
{%- endif %}
  <button id="reset-view" type="button"
          title="Reload this page as it was generated. A representation added from the
Mol* panel is not colored by the CSV; this puts the coloring back.">Reset view</button>
{%- if show_label_toggle %}
  <label title="Show or hide every label drawn on the structure, including the copy on
each symmetry mate. Mouseover tooltips are separate and keep working either way.">
    <input id="label-toggle" type="checkbox" checked> Labels</label>
{%- endif %}
  <span id="status">Loading structure&hellip;</span>
</div>

{# One caption per view; the selector shows the one belonging to the view on screen. #}
<div id="header">
{%- for view in views %}
  <div class="caption" data-view="{{ view.slug }}"{% if not loop.first %} hidden{% endif %}>{{ view.caption | safe }}</div>
{%- endfor %}
</div>

{# The whole page -- coordinates, annotations, and the MVS state -- as a base64
   MVSX archive. Kept in a non-executing script block so the payload is never
   parsed as JavaScript. #}
<script id="mvsx-payload" type="text/plain">{{ mvsx_base64 }}</script>

<script>
(function () {
    var status = document.getElementById('status');
    var payload = document.getElementById('mvsx-payload').textContent.trim();
    var VIEWS = {{ views | map(attribute='slug') | list | tojson }};

    function fail(err) {
        status.textContent = 'Failed to load: ' + err;
        console.error(err);
    }

    molstar.Viewer.create('viewer', {
        layoutIsExpanded: false,
        // Leave the Mol* UI enabled: everything this file sets is the initial
        // state, not a lock, so representations and colors stay editable.
        layoutShowControls: true,
        layoutShowSequence: true,
        layoutShowLog: false,
        layoutShowRemoteState: false,
        layoutShowLeftPanel: true,
        collapseLeftPanel: true,
        // The camera icon, which is the only route to an image. Its own panel is
        // where the resolution is set, so a button of ours beside Reset view could
        // only ever download at whatever that panel already said.
        viewportShowScreenshotControls: true,
        viewportShowExpand: true,
        viewportShowSelectionMode: true,
        viewportShowAnimation: false
    }).then(function (viewer) {
        window.viewer = viewer;

        // MVS attaches per-residue color to each representation it creates, so a
        // representation added later from the Components panel comes in uncolored
        // and cannot be colored from the UI. Reloading the state is the way back.
        // The payload is still sitting in the DOM, so keeping this costs nothing.
        function load() {
            return viewer.loadMvsData('base64,' + payload, 'mvsx');
        }

        var PSO = molstar.lib.plugin.PluginStateObject;
        var toggle = document.getElementById('label-toggle');
        var select = document.getElementById('view-select');

        // Which view each state cell belongs to, as {cell ref: view slug}.
        //
        // Every view is one MVS structure node carrying ref="view:<slug>", which
        // Mol* records as the cell tag "mvs-ref:view:<slug>" and resolves through
        // queryMVSRef. Everything the view draws hangs below that node, so the
        // owner map is that node plus its descendants. Rebuilt after every load,
        // because reloading the payload mints fresh cell refs.
        function ownerBySlug() {
            var state = viewer.plugin.state.data;
            var util = molstar.PluginExtensions.mvs.util;
            var owner = {};
            VIEWS.forEach(function (slug) {
                var found = util.queryMVSRef(viewer.plugin, 'view:' + slug);
                if (!found || !found.length) {
                    console.warn('prot-struct-viz: no cell tagged for view ' + slug);
                    return;
                }
                var stack = [found[0].transform.ref];
                while (stack.length) {
                    var ref = stack.pop();
                    owner[ref] = slug;
                    var children = state.tree.children.get(ref);
                    if (children) children.forEach(function (child) { stack.push(child); });
                }
            });
            return owner;
        }

        // One rule covers both controls, so neither can undo the other: a cell is
        // hidden if it belongs to a view that is not on screen, or it draws labels
        // and the Labels box is unchecked.
        //
        // Labels are found by object type rather than by transform name. Transform
        // ids are namespace-qualified -- the primitive builder is
        // "mvs.mvs-build-primitive-shape", not the bare name in the source -- and
        // "shape-representation-3d" is registered under two namespaces, so name
        // matching is both easy to get wrong and ambiguous. Scoping the scan to one
        // view's subtree also keeps it off any shape a reader adds from the Mol* UI.
        function applyVisibility() {
            var state = viewer.plugin.state.data;
            var active = select ? select.value : VIEWS[0];
            var labelsShown = !toggle || toggle.checked;
            var owner = ownerBySlug();
            Object.keys(owner).forEach(function (ref) {
                var cell = state.cells.get(ref);
                if (!cell) return;
                var isLabel = cell.obj && PSO.Shape.Representation3D.is(cell.obj);
                state.updateCellState(ref, {
                    isHidden: owner[ref] !== active || (isLabel && !labelsShown)
                });
            });
            Array.prototype.forEach.call(
                document.querySelectorAll('.caption'),
                function (caption) {
                    caption.hidden = caption.getAttribute('data-view') !== active;
                }
            );
        }

        if (toggle) { toggle.addEventListener('change', applyVisibility); }
        // Switching views only writes isHidden, so the camera stays exactly where
        // the reader left it. That is the whole reason the views are prebuilt
        // rather than reloaded one at a time.
        if (select) { select.addEventListener('change', applyVisibility); }

        document.getElementById('reset-view').addEventListener('click', function () {
            status.textContent = 'Resetting…';
            load().then(function () {
                applyVisibility();
                status.textContent = '';
            }).catch(fail);
        });
        return load().then(applyVisibility);
    }).then(function () {
        status.textContent = '';
    }).catch(fail);
})();
</script>

</body>
</html>
