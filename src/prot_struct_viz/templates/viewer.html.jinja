<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title }}</title>
<script src="https://cdn.jsdelivr.net/npm/molstar@{{ molstar_version }}/build/viewer/molstar.js"></script>
<link rel="stylesheet" type="text/css"
      href="https://cdn.jsdelivr.net/npm/molstar@{{ molstar_version }}/build/viewer/molstar.css">
<style>
  body { margin: 0; padding: 0.75rem 1rem 1rem;
         font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
         color: #24292f; }
  #header { max-width: 60rem; margin-top: 1rem; }
  #header:empty { display: none; }
  #controls { display: flex; gap: 0.5rem; align-items: center; margin: 0.75rem 0; }
  #controls button { font: inherit; padding: 0.3rem 0.7rem; cursor: pointer;
                     border: 1px solid #d0d7de; border-radius: 6px; background: #f6f8fa; }
  #controls button:hover { background: #eaeef2; }
  #controls label { display: flex; gap: 0.3rem; align-items: center; cursor: pointer;
                    user-select: none; }
  #status { color: #57606a; font-size: 0.9rem; }
  /* Mol* fills this box and positions its own UI inside it. */
  #viewer { position: relative; width: 100%; height: 70vh; min-height: 30rem; }
</style>
</head>
<body>

<div id="viewer"></div>

{# Controls and caption both sit below the structure, so the page opens on the view
   rather than on however many paragraphs the Markdown runs to. The controls come
   first of the two, staying next to the thing they act on. #}
<div id="controls">
  <button id="reset-view" type="button"
          title="Reload this view as it was generated. A representation added from the
Mol* panel is not colored by the CSV; this puts the coloring back.">Reset view</button>
{%- if show_label_toggle %}
  <label title="Show or hide every label drawn on the structure, including the copy on
each symmetry mate. Mouseover tooltips are separate and keep working either way.">
    <input id="label-toggle" type="checkbox" checked> Labels</label>
{%- endif %}
  <span id="status">Loading structure&hellip;</span>
</div>

<div id="header">{{ title_html | safe }}</div>

{# The whole view -- coordinates, annotations, and the MVS state -- as a base64
   MVSX archive. Kept in a non-executing script block so the payload is never
   parsed as JavaScript. #}
<script id="mvsx-payload" type="text/plain">{{ mvsx_base64 }}</script>

<script>
(function () {
    var status = document.getElementById('status');
    var payload = document.getElementById('mvsx-payload').textContent.trim();

    function fail(err) {
        status.textContent = 'Failed to load: ' + err;
        console.error(err);
    }

    molstar.Viewer.create('viewer', {
        layoutIsExpanded: false,
        // Leave the Mol* UI enabled: everything this file sets is the initial
        // state, not a lock, so representations and colors stay editable.
        layoutShowControls: true,
        layoutShowSequence: true,
        layoutShowLog: false,
        layoutShowRemoteState: false,
        layoutShowLeftPanel: true,
        collapseLeftPanel: true,
        // The camera icon, which is the only route to an image. Its own panel is
        // where the resolution is set, so a button of ours beside Reset view could
        // only ever download at whatever that panel already said.
        viewportShowScreenshotControls: true,
        viewportShowExpand: true,
        viewportShowSelectionMode: true,
        viewportShowAnimation: false
    }).then(function (viewer) {
        window.viewer = viewer;

        // MVS attaches per-residue color to each representation it creates, so a
        // representation added later from the Components panel comes in uncolored
        // and cannot be colored from the UI. Reloading the state is the way back.
        // The payload is still sitting in the DOM, so keeping this costs nothing.
        function load() {
            return viewer.loadMvsData('base64,' + payload, 'mvsx');
        }

        // Persistent labels are MVS primitives, so they are not an entry in the
        // Components panel that a reader could switch off; the page has to offer the
        // control itself. Mol* honours isHidden on the *representation* cell, so that
        // is what we collect.
        //
        // They are found by object type rather than by the name of the transform that
        // built them. Transform ids are namespace-qualified -- the primitive builder is
        // "mvs.mvs-build-primitive-shape", not the bare name that appears in the
        // source -- and "shape-representation-3d" is registered twice under two
        // namespaces, so name matching is both easy to get wrong and ambiguous.
        // PluginStateObject is a real exported API and every class on it has .is().
        //
        // This relies on labels being the only shape primitives we emit: the mesh and
        // lines nodes Mol* creates alongside them yield StateObject.Null when empty, so
        // no representation is built for either. Emit a mesh or a line from
        // build_label_primitives and this would start hiding it too.
        var PSO = molstar.lib.plugin.PluginStateObject;
        var toggle = document.getElementById('label-toggle');

        function labelRepresentations() {
            var refs = [];
            viewer.plugin.state.data.cells.forEach(function (cell, ref) {
                if (cell.obj && PSO.Shape.Representation3D.is(cell.obj)) refs.push(ref);
            });
            return refs;
        }

        // Called after every load, not just on change: reloading the payload rebuilds
        // the state tree with fresh refs and everything visible, which would otherwise
        // leave an unchecked box beside labels that came back.
        function applyLabelVisibility() {
            if (!toggle) return;
            var state = viewer.plugin.state.data;
            var hidden = !toggle.checked;
            var refs = labelRepresentations();
            // The checkbox is only rendered because labels were drawn, so finding none
            // means an internal Mol* API moved under us. Say so: the first version of
            // this code failed exactly here, and failed silently.
            if (!refs.length) {
                console.warn('prot-struct-viz: found no label representations to ' +
                             'toggle; the Labels checkbox will do nothing.');
            }
            refs.forEach(function (ref) {
                state.updateCellState(ref, { isHidden: hidden });
            });
        }

        if (toggle) {
            toggle.addEventListener('change', applyLabelVisibility);
        }

        document.getElementById('reset-view').addEventListener('click', function () {
            status.textContent = 'Resetting…';
            load().then(function () {
                applyLabelVisibility();
                status.textContent = '';
            }).catch(fail);
        });
        return load().then(applyLabelVisibility);
    }).then(function () {
        status.textContent = '';
    }).catch(fail);
})();
</script>

</body>
</html>
